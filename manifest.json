{
    "manifest_version": 3,
    "name": "Weather Rock",
    "description": "An extension for the weather rock to tell you the weather.",
    "version": "1.0",
    "icons": {
        "16": "images/icon-16.png",
        "32": "images/icon-32.png",
        "48": "images/icon-48.png",
        "128": "images/icon-128.png"
    },
    "action": {
        "default_title": "Weather Rock",
        "default_popup": "popup.html"
    },
    "permissions": [
        "geolocation"
    ]
}